# Cấu hình Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
# Điền gemini-3.6-pro hoặc gemini-1.5-pro nếu tài khoản của bạn là Pro/Advanced
GEMINI_MODEL=gemini-3.6-flash

# Firebase Configuration (Client)
NUXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NUXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Google Analytics 4
NUXT_PUBLIC_GTAG_ID=G-XXXXXXXXXX

# Firebase Admin SDK (Server)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIB...your_private_key...==\n-----END PRIVATE KEY-----\n"

# Cloudflare Turnstile & OG Image
NUXT_PUBLIC_SITE_URL=http://localhost:3001
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NUXT_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

OPENROUTER_API_KEY=
